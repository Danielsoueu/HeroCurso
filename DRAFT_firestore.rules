rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Coleção de Usuários
    match /users/{userId} {
      allow read, write: if true;
    }

    // Configurações do Workspace
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Regra geral
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
