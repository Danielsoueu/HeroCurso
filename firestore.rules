rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isSuperAdminEmail() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        (
          request.auth.token.email.toLower() == 'danielmelo@companyhero.com' ||
          request.auth.token.email.toLower() == 'danielcontaescolha@gmail.com' ||
          request.auth.token.email in ['danielmelo@companyhero.com', 'danielcontaescolha@gmail.com']
        );
    }

    function isAdmin() { 
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    match /users/{userId} {
      // Allow any signed in user to read the user directory
      allow read: if isSignedIn();
      
      allow create, update: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == userId
      );

      allow delete: if isAdmin();
    }
  }
}
